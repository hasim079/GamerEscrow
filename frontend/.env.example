# ==============================================================================
# GamerEscrow - Environment Variables
# ==============================================================================

# ─── Solana Configuration ─────────────────────────────────────────────────────
# RPC URL for Solana connection (Devnet is recommended for testing)
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"

# The Program ID of the deployed Anchor smart contract
NEXT_PUBLIC_PROGRAM_ID="EjhkjCLXe6aPg1zpSi9ihJemo4JvYVacQzSi8Nbczytp"

# The public key of the admin wallet that will resolve disputes
NEXT_PUBLIC_ADMIN_PUBKEY="3trynVPFszVYU4UavqhUJpe1RyhkV5icAcmJ77mArNzP"


# ─── Supabase Configuration ───────────────────────────────────────────────────
# Your Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Anon Key (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Your Supabase Service Role Key (Secret - Used for API routes to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"


# ─── Security / Crypto ────────────────────────────────────────────────────────
# A random 32-byte string (64 hex characters) used for encryption/decryption
# of game credentials. You can generate one via: `openssl rand -hex 32`
ENCRYPTION_SECRET_KEY="your-32-byte-hex-string-here"
